# oauth2-proxy (Entra ID) — örnek ortam değişkenleri.
# GERÇEK SIRLARI BURAYA YAZMAYIN. Bu dosya örnektir; gerçek değerler sunucudaki
# .env dosyasında (repoya commit'lenmeyen) veya Azure DevOps secret'larında tutulur.

# --- Entra ID App Registration (Sam doldurur) ---
# Kiracı (tenant) kimliği — GUID.
ENTRA_TENANT_ID=

# App Registration client id ve secret.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# oauth2-proxy'nin dış URL'i + /oauth2/callback. Entra App Registration'daki
# redirect URI ile BİREBİR aynı olmalı.
#   ör: https://ssi.example.com/oauth2/callback
OAUTH2_PROXY_REDIRECT_URL=

# Çerez şifreleme anahtarı. 32 baytlık rastgele değer üretin, ör:
#   python -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=

# --- SSI RBAC (proxy arkasında AÇILIR) ---
# Bu üç değer SSI'ın .env'ine girer (temel compose bunları okur):
#   SSI_RBAC_ENFORCED=true
#   SSI_TRUST_ACTOR_HEADER=true
#   SSI_DEV_LOGIN=false
#
# Grup -> rol eşlemesi. Entra, groups claim'inde grup ADI değil grup NESNE
# KİMLİĞİNİ (GUID) gönderir; bu yüzden anahtarlar GUID'dir. Sam mevcut
# grupların GUID'lerini verir, siz rollere eşlersiniz:
#   SSI_RBAC_GROUP_ROLE_MAP=11111111-1111-1111-1111-111111111111:approver, 22222222-2222-2222-2222-222222222222:operator, 33333333-3333-3333-3333-333333333333:viewer
#
# (İstenirse Entra tarafında grup adı claim'i açılabilir; o zaman anahtar olarak
# ad kullanılır. Varsayılan GUID'dir.)
