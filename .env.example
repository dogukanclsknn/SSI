# SSI runtime configuration (do not put real secrets in this file)

# Frontend API mode. In production, "api" lets the React app call /api/v1.
VITE_API_MODE=api
VITE_API_BASE_URL=/api/v1

# Harbor inventory integration.
HARBOR_URL=https://registry.example.com
HARBOR_PROJECT=ssi-images
# Optional: scan multiple Harbor projects (comma-separated). When set, this
# overrides HARBOR_PROJECT for inventory/scan listing. Leave empty to use
# HARBOR_PROJECT only. The robot account must have read access to every project.
HARBOR_PROJECTS=
HARBOR_ROBOT_USERNAME=robot$ssi-images+ssi-reader

# Set this only as an environment secret in the server/pipeline, never commit it.
HARBOR_ROBOT_SECRET=

# Verify the Harbor TLS certificate (default true). Mount the corporate CA into the
# runtime trust store instead of disabling this; false is for isolated labs only.
HARBOR_TLS_VERIFY=true

# Sample inventory/scan data for local UI development without Harbor. Default false:
# an unconfigured or failing Harbor then shows an empty, clearly labelled state.
# Sample scans are never used as verification evidence, even when this is true.
SSI_FIXTURES=false

# Host address the SSI port is published on (docker-compose). Default 0.0.0.0,
# because the external reverse proxy and the Azure DevOps worker callbacks reach
# port 5021 over the network; restrict access with the firewall. Use 127.0.0.1 only
# when the reverse proxy runs on the same host as SSI.
SSI_BIND_ADDRESS=0.0.0.0

# Persistence. "memory" loses all data on restart (PoC/demo). Set "postgres" to
# persist users/roles, remediation jobs, audit trail and publish requests.
#
# The bundled docker-compose ships a "ssi-postgres" container (Postgres 16) with a
# named volume, plus a one-shot "ssi-migrate" step. To activate persistence:
#   1) Set PERSISTENCE_DRIVER=postgres below.
#   2) Set POSTGRES_PASSWORD and point DATABASE_URL at the ssi-postgres service.
#      Internal docker network is not TLS, so DATABASE_SSL_MODE=disable is correct.
#   3) Deploy: docker compose up -d --build  (migration runs automatically).
#
# Example activation (uncomment and set a real password):
#   PERSISTENCE_DRIVER=postgres
#   POSTGRES_DB=ssi
#   POSTGRES_USER=ssi
#   POSTGRES_PASSWORD=<strong-password>
#   DATABASE_URL=postgresql://ssi:<strong-password>@ssi-postgres:5432/ssi
#   DATABASE_SSL_MODE=disable
PERSISTENCE_DRIVER=memory
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Credentials for the bundled ssi-postgres container (docker-compose). Only used
# when PERSISTENCE_DRIVER=postgres. Leave blank in memory mode.
POSTGRES_DB=ssi
POSTGRES_USER=ssi
POSTGRES_PASSWORD=

# Where Postgres stores its data on the HOST. A bind-mount OUTSIDE the deploy tree
# (default /data/ssi-postgres-data) so that `docker compose down -v` and pipeline
# redeploys cannot wipe it. The directory is created automatically on first start.
SSI_POSTGRES_DATA_DIR=/data/ssi-postgres-data

# TLS to PostgreSQL. For the bundled container on the internal docker network use
# "disable". For an EXTERNAL managed database use "verify-full" with the corporate
# CA mounted read-only. `require` encrypts but does not verify the server identity.
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERT_PATH=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=ssi-api

# Audit actor used when no trusted identity is present.
SSI_AUDIT_ACTOR_ID=ssi-api
# Trust X-Forwarded-User / X-Forwarded-Groups from an authenticating reverse proxy
# (oauth2-proxy / Entra ID). Roles are ALWAYS derived server-side from
# SSI_RBAC_GROUP_ROLE_MAP or SSI_RBAC_ROLE_BINDINGS; a client-supplied role header is
# never read. Enable only when the proxy strips inbound copies of these headers and
# SSI is not reachable directly.
SSI_TRUST_ACTOR_HEADER=false

# RBAC (roles & permissions). Identity precedence: signed session cookie (LDAP /
# local admin) → authenticating proxy → dev login. Roles: viewer, operator,
# approver, admin.
# Enforced by default; false disables authorisation entirely (isolated labs only).
SSI_RBAC_ENFORCED=true
# Role given to every caller only when enforcement is disabled.
SSI_RBAC_DEFAULT_ROLES=admin
# Proxy rol enjekte etmiyorsa sunucu-tarafı rol ataması (opsiyonel).
# Biçim: "alice:approver, bob:operator|admin"
SSI_RBAC_ROLE_BINDINGS=
# oauth2-proxy / Entra ID entegrasyonu: X-Forwarded-Groups → SSI rolleri eşlemesi.
# Entra, groups claim'inde grup ADI değil grup NESNE KİMLİĞİNİ (GUID) gönderir;
# anahtarlar bu yüzden GUID'dir. Çalıştırılabilir yapılandırma: deploy/oauth2-proxy/.
# Biçim: "<grup-guid>:approver, <grup-guid>:operator, <grup-guid>:viewer"
SSI_RBAC_GROUP_ROLE_MAP=
# Dev/demo login (demo only). The UI lets the user pick a subject + role and sends
# X-SSI-Actor-Id / X-SSI-Actor-Roles, which the server honours ONLY while this is
# true. It is not authentication — keep it false in production.
SSI_DEV_LOGIN=false

# --- Multi-tenancy (teams) — docs/multi-tenancy.md ---
# Off by default: every record is in the 'default' team, the global role applies and the
# console shows no team controls. true scopes every team-owned record, the Harbor
# inventory and the scans to the caller's team (published images stay a shared catalog);
# the team role replaces the global role (users.role=admin stays platform admin). Teams
# onboard into onboarded/<team>/ and publish into approved/<team>/ unless their record
# says otherwise. Requires SSI_RBAC_ENFORCED=true.
SSI_MULTI_TENANCY=false

# --- Identity: LDAP/AD sign-in + local admin (production path) ---
# LDAP only AUTHENTICATES; a user's ROLE is held in SSI and assigned by an admin on
# the Users screen. A user signing in via LDAP for the first time gets the viewer role.
# Fill in LDAP_* and/or SSI_LOCAL_ADMIN_* plus SSI_SESSION_SECRET below.
LDAP_SERVER=
LDAP_FQDN=
LDAP_PORT=636
LDAP_SSL=true
# Verify the directory certificate (default true). Provide the CA with LDAP_CA_FILE
# rather than disabling this; false is for isolated labs only.
LDAP_VERIFY=true
LDAP_CA_FILE=
# Dizini aramak için servis hesabı. Şifre SIRDIR — yalnızca burada/secret olarak.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_NETBIOS=

# Session cookie signing secret. Required whenever LDAP or the local admin is
# configured; SSI refuses to start if it is shorter than 32 bytes. Generate and keep
# it as a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sessions last 8 hours, carry a unique id and are revoked server-side at sign-out.
# Sign-in is throttled: 5 failures per username or 50 per client address within 15
# minutes return 429 until the window ends.
SSI_SESSION_SECRET=
# Çerezler HTTPS arkasında Secure olmalı. YALNIZCA izole yerel (http) testte false.
SSI_SESSION_COOKIE_SECURE=true

# Lokal admin — LDAP'sız bootstrap yönetici. Şifre DÜZ METİN TUTULMAZ; hash üretin:
#   node scripts/hash-password.mjs   (şifreyi yazın; çıkan hash'i buraya koyun)
SSI_LOCAL_ADMIN_USERNAME=
SSI_LOCAL_ADMIN_PASSWORD_HASH=
SSI_LOCAL_ADMIN_DISPLAY=
SSI_LOCAL_ADMIN_EMAIL=

# Fail-closed publish policy. Requester/approver identities must be injected by
# an authenticated reverse proxy before trusted actor headers are enabled.
# The version is only the label stored on decisions; leave it at the code's version
# (docker-compose.yml default) so the label matches the checks that ran.
SSI_PUBLISH_POLICY_VERSION=ssi.publish-policy/v1.4
SSI_PUBLISH_MAX_CRITICAL=0
SSI_PUBLISH_MAX_HIGH=0
# Tedarik zinciri kapıları (Tema F). true yapıldığında yalnızca İMZALI + SBOM'lu +
# provenance'lı imajlar yayınlanabilir. Kanıtı izole publish worker'ı üretir (açık kaynak
# Cosign + Syft) ve /remediation/:id/supply-chain-evidence ile SSI'ya gönderir. Kanıt
# gelmeden ve doğrulanmadan (fail-closed) publish bloklanır. Bu faz: kademeli aç.
SSI_PUBLISH_REQUIRE_SBOM=false
SSI_PUBLISH_REQUIRE_SIGNATURE=false
SSI_PUBLISH_REQUIRE_PROVENANCE=false
# Pre-release testing (policy v1.3). The automatic candidate test (SSI - Candidate Test
# pipeline) must always pass. Consumer acceptance — a team tries the candidate in its own
# environment and marks it "Tested — OK" — is required unless set to false here. A reported
# issue blocks publish even when this is false; the requester can never accept.
SSI_PUBLISH_REQUIRE_CONSUMER_ACCEPTANCE=true
PUBLISH_TARGET_REGISTRY=registry.example.com
PUBLISH_TARGET_PROJECT=ssi-images
PUBLISH_TARGET_REPOSITORY_PREFIX=approved
# Publish approval is ROLE based: the "approver" or "admin" role may approve
# (integrated with RBAC). SSI_PUBLISH_APPROVERS is an OPTIONAL extra e-mail/username
# allowlist on top of the roles; leave blank to rely purely on roles.
SSI_PUBLISH_APPROVERS=
# Separation of duties: the requester can never approve their own publish request
# (two-person rule). On by default; false disables it explicitly.
SSI_PUBLISH_REQUIRE_SEPARATE_APPROVER=true

# Risk acceptance (policy exceptions). An approved exception removes one CVE in one
# repository from the Critical/High publish thresholds until it expires. The two-person
# rule always applies. Maximum duration in days; Critical findings use the shorter limit.
SSI_EXCEPTION_MAX_DAYS=90
SSI_EXCEPTION_MAX_DAYS_CRITICAL=30

# Set these only in the API runtime and Azure DevOps secret variables. The
# handoff and receipt credentials are deliberately separate.
SSI_PUBLISH_HANDOFF_TOKEN=
# Publish receipts are HMAC-signed by the worker (azure-pipelines-controlled-publish.yml, ADO
# secret variable of the same name). At least 32 random bytes, separate from the other secrets.
SSI_PUBLISH_RECEIPT_HMAC_SECRET=
# Migration only: while set, an unsigned receipt carrying this token is still accepted (and
# logged). Leave empty once the worker signs its receipts; then unsigned receipts get 401.
SSI_PUBLISH_RECEIPT_TOKEN=

# Shared only by SSI API and the isolated remediation worker. Generate at least
# 32 random bytes and store it as a secret; never commit the real value.
SSI_REMEDIATION_EVIDENCE_HMAC_SECRET=
SSI_REMEDIATION_EVIDENCE_MAX_AGE_SECONDS=300

# Shared only by SSI API and the supply-chain signing worker (azure-pipelines-supply-
# chain-sign.yml, ADO secret variable of the same name). At least 32 random bytes.
# A separate secret from the remediation worker: each worker can only sign its own
# evidence type. If unset, the worker publishes the receipt as an artifact and an
# operator uploads it from the UI (audited as a manual upload).
SSI_SUPPLY_CHAIN_EVIDENCE_HMAC_SECRET=

# Shared only by SSI API and the candidate test worker (azure-pipelines-candidate-test.yml,
# ADO secret variable of the same name). At least 32 random bytes, separate from the other
# worker secrets. If unset, the worker publishes the result as an artifact and an operator
# uploads it on the RM-EXEC page (audited as a manual upload).
SSI_CANDIDATE_TEST_EVIDENCE_HMAC_SECRET=

# Shared only by SSI API and the canonical scan worker (azure-pipelines-canonical-trivy-scan.yml,
# ADO secret variable of the same name). At least 32 random bytes, separate from the other
# worker secrets. If unset, the worker only publishes canonical-trivy.json as an artifact and an
# operator uploads it on the Dry Run page (audited as a manual upload).
SSI_CANONICAL_REPORT_HMAC_SECRET=

# Shared only by SSI API and the image inspection worker (azure-pipelines-image-inspection.yml,
# ADO secret variable of the same name). At least 32 random bytes, separate from the other
# worker secrets. If unset, inspections are refused (503) and Scan Results compares two
# images by vulnerability only. See docs/image-inspection-worker.md.
SSI_IMAGE_INSPECTION_EVIDENCE_HMAC_SECRET=

# Shared only by SSI API and the OS template workers (azure-pipelines-os-template-windows.yml
# and azure-pipelines-os-template-ubuntu.yml, ADO secret variable of the same name on each). At
# least 32 random bytes, separate from the other worker secrets. If unset, template results are
# refused (503). See docs/os-template-poc.md ("Windows", "Ubuntu").
SSI_OS_TEMPLATE_EVIDENCE_HMAC_SECRET=

# Azure DevOps otomasyonu (Faz 1: SSI yalnızca listelenen worker pipeline'larını başlatabilir).
# Hepsi boşsa SSI bugünkü gibi elle çalışır. Ayrıntı: docs/azure-devops-integration.md
#   SSI_ADO_ORG_URL   : https://example-org.visualstudio.com (yalnızca dev.azure.com / *.visualstudio.com)
#   SSI_ADO_PROJECT   : SecureImages
#   SSI_ADO_PAT       : Personal Access Token (SECRET; gizli girişle yazılır, asla ekrana/sohbete değil)
#   SSI_ADO_PIPELINE_*: her worker pipeline'ının definition ID'si (URL'deki definitionId=...)
SSI_ADO_ORG_URL=
SSI_ADO_PROJECT=
SSI_ADO_PAT=
SSI_ADO_PIPELINE_REF=refs/heads/main
# SSI address the onboard, publish and sign workers call back (their ssiApiBaseUrl parameter);
# same value as the SSI_API_BASE_URL pipeline variable. http:// sends allowInsecurePocApi=true.
SSI_ADO_WORKER_API_BASE_URL=
SSI_ADO_PIPELINE_ONBOARD_IMPORT=
SSI_ADO_PIPELINE_CANONICAL_SCAN=
SSI_ADO_PIPELINE_COPA_REMEDIATION=
SSI_ADO_PIPELINE_CANDIDATE_TEST=
SSI_ADO_PIPELINE_IMAGE_INSPECTION=
SSI_ADO_PIPELINE_CONTROLLED_PUBLISH=
SSI_ADO_PIPELINE_SUPPLY_CHAIN_SIGN=
SSI_ADO_PIPELINE_OS_TEMPLATE_WINDOWS=
SSI_ADO_PIPELINE_OS_TEMPLATE_UBUNTU=

# Tedarik zinciri (Cosign imza + Syft SBOM + provenance) — açık kaynak, key-based.
# Bu değerler yalnızca izole publish worker'ında (Azure DevOps SECRET) tutulur; SSI API
# yalnızca doğrulanmış kanıt receipt'ini alır, imzalama sırlarını GÖRMEZ.
#   COSIGN_PRIVATE_KEY        : cosign.key'in BASE64'ü (tek satır; worker base64 -d ile çözer) (secret)
#   COSIGN_PASSWORD           : private key parolası (secret)
#   COSIGN_PUBLIC_KEY         : cosign.pub'ın BASE64'ü (tek satır)
#   SBOM_FORMAT               : cyclonedx-json (varsayılan) | spdx-json
# İleride esneklik: KMS ile imzalama (COSIGN_KEY=azurekms://... / hashivault://...) ya da
# keyless (Fulcio/Rekor) worker tarafında değiştirilir; SSI mantığı aynı kalır.
COSIGN_PRIVATE_KEY=
COSIGN_PASSWORD=
COSIGN_PUBLIC_KEY=
SBOM_FORMAT=cyclonedx-json

# Onboarding (quarantine import). External images are imported into a dedicated
# quarantine prefix under the target project, isolated from approved/. SSI only
# orchestrates the request; the isolated onboarding worker (Azure pipeline) owns
# the Harbor write credential and does the pull/copy/scan.
ONBOARD_TARGET_REGISTRY=registry.example.com
ONBOARD_TARGET_PROJECT=ssi-images
ONBOARD_TARGET_REPOSITORY_PREFIX=onboarded
# Approved intake registries (comma-separated). Required: while it is empty SSI refuses
# every onboarding request (fail-closed) and logs a warning at start-up. Requests for
# images from any other registry are rejected with 422. Docker Hub aliases
# (index.docker.io, registry-1.docker.io) count as docker.io.
ONBOARD_ALLOWED_REGISTRIES=docker.io

# Set these only in the API runtime and Azure DevOps secret variables. The
# handoff and receipt credentials are deliberately separate.
ONBOARD_HANDOFF_TOKEN=
# Onboarding receipts are HMAC-signed by the worker (azure-pipelines-onboard-import.yml, ADO
# secret variable of the same name). At least 32 random bytes, separate from the other secrets.
SSI_ONBOARD_RECEIPT_HMAC_SECRET=
# Migration only, as SSI_PUBLISH_RECEIPT_TOKEN above: leave empty once receipts are signed.
ONBOARD_RECEIPT_TOKEN=
